# The Boss Remembers — environment template.
# Copy to `.env` (never commit `.env`). All values below are safe placeholders.

# --- PostgreSQL container (used by docker-compose.yml) ---
POSTGRES_USER=boss
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=boss_remembers
POSTGRES_PORT=5433

# --- Server database connection (must match the values above) ---
DATABASE_URL=postgres://boss:change_me_locally@localhost:5433/boss_remembers
# Separate database used by `npm test`. It is created automatically if missing and wiped between tests.
TEST_DATABASE_URL=postgres://boss:change_me_locally@localhost:5433/boss_remembers_test

# --- API server ---
PORT=4000
# Allowed browser origin for the Vite dev server.
CLIENT_ORIGIN=http://localhost:5173

# --- Python ML (training + inference worker) ---
# Python 3.10+ with packages from ml/requirements.txt. Use a full path on Windows if `python`
# resolves to an interpreter without xgboost (e.g. C:\Path\To\Python312\python.exe or ml\.venv\Scripts\python.exe).
PYTHON_BIN=python
# Where trained model artifacts and exported datasets are written (relative to repo root).
ARTIFACTS_DIR=artifacts

# --- Game configuration ---
# Default maximum rounds for a new run (the player can end a run earlier).
DEFAULT_MAX_ROUNDS=10
