{
  "//": "Root workspace for The Boss Remembers. Scripts delegate to the server/client workspaces so every documented command runs from the repo root.",
  "name": "the-boss-remembers",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "npm run migrate -w server",
    "db:check": "npm run db:check -w server",
    "dev": "concurrently -n server,client -c yellow,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "balance": "npm run balance -w server --",
    "v3:baseline": "npm run v3:baseline -w server --",
    "sim": "npm run sim -w server --",
    "ml:build-dataset": "npm run ml:build-dataset -w server --",
    "ml:export": "npm run ml:export -w server --",
    "ml:train": "npm run ml:train -w server --",
    "ml:activate": "npm run ml:activate -w server --",
    "ml:status": "npm run ml:status -w server --",
    "ml:oracle": "npm run ml:oracle -w server --",
    "ml:v4-oracle": "npm run ml:v4-oracle -w server --",
    "ml:v4-data": "npm run ml:v4-data -w server --",
    "ml:v4-learning": "npm run ml:v4-learning -w server --",
    "ml:planner-lab": "npm run ml:planner-lab -w server --",
    "ml:planner-lab-combine": "npm run ml:planner-lab-combine -w server --",
    "test": "npm run test -w server && npm run test -w client",
    "test:unit": "npm run test:unit -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "v3:lab": "npm run v3:lab -w server --",
    "v3:eval": "npm run v3:eval -w server --"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
