{
  "//": "API server, game engine, boss AI, simulation runner and ML orchestration (TypeScript, run with tsx).",
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:testdb": "tsx src/dev-testdb.ts",
    "start": "tsx src/index.ts",
    "migrate": "tsx src/db/migrate.ts",
    "db:check": "tsx src/db/check.ts",
    "balance": "tsx src/sim/balance-cli.ts",
    "sim": "tsx src/sim/cli.ts",
    "boss:bench": "tsx src/boss/bench.ts",
    "ml:build-dataset": "tsx src/ml/cli.ts build-dataset",
    "ml:export": "tsx src/ml/cli.ts export",
    "ml:train": "tsx src/ml/cli.ts train",
    "ml:activate": "tsx src/ml/cli.ts activate",
    "ml:status": "tsx src/ml/cli.ts status",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "typecheck": "tsc --noEmit",
    "v3:baseline": "tsx src/sim/v3-baseline-cli.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.6",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
